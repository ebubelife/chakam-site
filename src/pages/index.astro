---
import BaseLayout from '../layouts/BaseLayout.astro';

const appStoreUrl = 'https://apps.apple.com/ng/app/chakam-chat-wrapped-red-flag/id6792742396';
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.chakam.chatanalyzer';

// One source of truth for both the visible FAQ section and its FAQPage
// JSON-LD below — schema and what a visitor actually sees can never drift
// out of sync this way (a real risk if they were maintained separately).
const faqs = [
  {
    q: 'Does my raw chat ever leave my phone?',
    a: 'No — the metrics and cards you see are calculated on-device. The only things that can leave are a small, aliased sample used to write the AI verdict, and screenshot images for sources that require OCR (Instagram, Snapchat, Messenger, iMessage) — full details in the <a href="/privacy/">Privacy Policy</a>.',
  },
  {
    q: 'Do I need to create an account?',
    a: 'No. Open the app, import a chat, and you’re straight into your results.',
  },
  {
    q: 'What does the subscription unlock?',
    a: 'The free tier gives you a first set of cards on every analysis. Premium unlocks the rest of the deck — red flag detail, ghosting risk, reply-speed breakdowns, and the full AI verdict.',
  },
  {
    q: 'Can I delete my data?',
    a: 'Yes, anytime — "Clear all data" in Settings wipes everything stored on your device. We don’t have a server-side copy to delete, because we never keep one.',
  },
  {
    q: 'Is Chakam free to download?',
    a: 'Yes — Chakam is completely free to download on iOS and Android, with no signup required to start. Every chat analysis you run comes with a free AI verdict card and a first set of report cards at no cost, so you can try the chat analyzer for yourself before paying anything. For the full deck — detailed Red Flag and Green Flag Reports, the Ghost Risk Meter, Interest Over Time, and more — you can upgrade to one of our affordable premium plans whenever you’re ready for deeper relationship insights.',
  },
  {
    q: 'Will my data be used to train AI models?',
    a: 'No — never. Your chats, screenshots, and personal data are not used to train AI models, improve machine learning systems, or build any dataset, ours or a third party’s. We also don’t store your data on our servers at all: each request is processed in real time and discarded immediately afterward. Your conversations exist in exactly one place — your own device — which is also why privacy and data protection are built into Chakam from the ground up, not bolted on as an afterthought.',
  },
  {
    q: 'How is Chakam better than a dating coach?',
    a: 'Chakam is available 24/7 — no appointments, no hourly rate, no waiting days for a session. It’s a judgment-free dating companion you can turn to any time you need clarity: decoding mixed signals late at night, getting a second opinion before you hit send, or making sense of a pattern you can’t quite name on your own. Chakam isn’t a substitute for professional relationship therapy or serious mental health support, but for everyday dating advice, relationship tips, and a data-driven gut-check before a big decision, it’s there the moment you actually need it — grounded in your real conversation, not generic advice.',
  },
  {
    q: 'What languages are supported?',
    a: 'Chakam supports multiple languages, so the tips, insights, and dating advice you get stay accurate no matter what language you text in. It’s built to understand real, everyday texting — not just formal phrasing — including modern slang, abbreviations, and emoji, so the read on tone, red flags, and vibe holds up whether you’re chatting in English, Spanish, Portuguese, French, or beyond.',
  },
  {
    q: 'How accurate are the insights?',
    a: 'Chakam’s accuracy comes from what it actually measures: objective communication signals — response timing, message frequency, emotional tone, and engagement consistency — rather than assumptions or guesswork. Because every insight is grounded in your real chat history instead of generic relationship advice, the resulting red flags, compatibility scores, and interest trends reflect genuine patterns in your dynamic. That said, Chakam is a data-driven analysis tool, not a replacement for your own judgment — it works best as a second opinion alongside your own read of the situation and the real-world context only you have.',
  },
];

// Schema.org wants plain text, not the markup — only one answer above
// actually has a tag in it (the Privacy Policy link), but stripping is
// cheap enough to just always do rather than special-case that one.
const stripTags = (html: string) => html.replace(/<[^>]+>/g, '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) },
  })),
};
---
<BaseLayout
  title="Chakam — Chat Wrapped, Red Flags Decoded"
  description="Chakam turns your WhatsApp, Telegram, and DM chats into a private, on-device wrapped: who's more into who, red flags, reply speed, and more."
  active="home"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="hero-band">
    <div class="hero-wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>Your chat,<br>fully wrapped.</h1>
          <p class="tagline">Import a chat, get the receipts — who's more into who, red flags, reply speed, who ghosts first. Everything's read on your phone, not a server.</p>

          <div class="store-row">
            <a class="store-badge" href={appStoreUrl}>
              <img src="/assets/img/apple_icon.png" alt="App Store">
              <span class="store-text">
                <span class="store-eyebrow">Download on the</span>
                <span class="store-name">App Store</span>
              </span>
            </a>
            <a class="store-badge" href={playStoreUrl}>
              <img src="/assets/img/png-clipart-goggle-playstore-icon-google-play-computer-icons-android-play-button-angle-rectangle.png" alt="Google Play">
              <span class="store-text">
                <span class="store-eyebrow">Get it on</span>
                <span class="store-name">Google Play</span>
              </span>
            </a>
          </div>

          <div class="trust-row">
            <span class="trust-pill">🔒 100% on-device by default</span>
            <span class="trust-pill">🆓 Free to start</span>
            <span class="trust-pill">🚫 No account required</span>
          </div>

          <a class="hero-how" href="#how">See how it works &darr;</a>
        </div>

        <div class="hero-visual">
          <img class="phone-mock" src="/assets/img/Add_a_subheading_4_-removebg-preview.png"
               alt="The Chakam app showing a chat's Vibe Check, AI verdict, and Green Flag Report">
          <div class="float-card float-card--1">
            <span class="float-emoji">🚩</span>
            <div class="float-text"><strong>Red Flag Report</strong><span>Score, plus the receipts</span></div>
          </div>
          <div class="float-card float-card--2">
            <span class="float-emoji">❤️‍🔥</span>
            <div class="float-text"><strong>Who's More Into Who</strong><span>Effort, ranked</span></div>
          </div>
          <div class="float-card float-card--3">
            <span class="float-emoji">👻</span>
            <div class="float-text"><strong>Ghost Risk Meter</strong><span>See it coming</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="why-band">
    <div class="why-wrap">
      <div class="why-grid">
        <div class="why-copy">
          <span class="kicker">Why Chakam exists</span>
          <h2>Stop decoding <span class="hl">mixed signals</span> on your own.</h2>
          <p>Chakam is an on-device AI chat analyzer built to turn a confusing conversation into clear answers — no guessing, no group chat poll, just your actual texts read by AI chat analysis that never leaves your phone.</p>
          <p>It tracks shifts in attitude and tone over time, effort and reciprocity, red flags, and ghosting risk — the patterns most people only notice weeks too late. It's a real chat analyzer, not a horoscope: every read is grounded in your own message history, not a generic script.</p>
        </div>

        <div class="stat-card">
          <span class="stat-card-label">Your chat with Rowland, decoded</span>
          <div class="stat-row">
            <span>Compatibility</span>
            <strong>71%</strong>
          </div>
          <div class="stat-row">
            <span>Interest trend</span>
            <strong>Rising ↑</strong>
          </div>
          <div class="stat-row">
            <span>Vibe, last 2 weeks</span>
            <strong>Warming up</strong>
          </div>
          <div class="stat-row">
            <span>Red flags</span>
            <strong>1 flagged</strong>
          </div>
          <div class="stat-row">
            <span>Ghost risk</span>
            <strong class="stat-good">Low</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="analyze-band">
    <div class="analyze-wrap">
      <div class="section-head">
        <span class="kicker">What Chakam analyzes</span>
        <h2>Everything hiding in your chat, decoded</h2>
        <p>A full AI chat analysis of your relationship, dating, or texting dynamic — every read grounded in your actual conversation, not a generic script.</p>
      </div>

      <div class="analyze-grid">
        <div class="analyze-card">
          <span class="tag tag-neutral">8+ sources supported</span>
          <h3>Multi-Platform Chat Analysis</h3>
          <p>Import a WhatsApp export directly, or bring screenshots from Instagram, Snapchat, Messenger, iMessage, Tinder, Hinge, and Bumble. One AI chat analyzer, every conversation you're trying to make sense of.</p>
        </div>

        <div class="analyze-card">
          <span class="tag tag-red">Red Flag Report · 62/100</span>
          <h3>Red Flag Score</h3>
          <p>A 0–100 red flag score built from real patterns — one-sided effort, ghosting, escalating arguments, money talk — not a vibe. Every flag comes with the receipts: exactly why it fired, and who triggered it.</p>
        </div>

        <div class="analyze-card">
          <span class="tag tag-green">Green Flag Report · 81/100</span>
          <h3>Green Flag Score</h3>
          <p>The inverse read: balanced energy, quick replies, no real fights, someone who steps up first after a rough patch. Chakam's relationship analysis credits what's actually working, not just what's wrong.</p>
        </div>

        <div class="analyze-card">
          <span class="tag tag-neutral">The Verdict</span>
          <h3>Detailed AI Verdict</h3>
          <p>A written verdict on the relationship dynamic, grounded in your actual chat stats — not a horoscope. Chakam explains the "why" behind the numbers, the way a brutally honest friend would read your texts.</p>
        </div>

        <div class="analyze-card">
          <span class="tag tag-green">Interest Over Time · Rising ↑</span>
          <h3>Interest Over Time</h3>
          <p>Track how much of the conversation each person has been carrying, week by week — not one interest score, but the whole trend line. See exactly when interest started rising, or when it began to fade.</p>
        </div>

        <div class="analyze-card">
          <span class="tag tag-neutral">Positivity vs Negativity</span>
          <h3>Positivity vs Negativity</h3>
          <p>Every message scored for warmth against friction, then tracked over time as a "Vibe Over Time" trend. Chakam's sentiment analysis shows whether things are genuinely warming up or quietly turning cold.</p>
        </div>

        <div class="analyze-card">
          <span class="tag tag-red">Ghost Risk Meter · Low</span>
          <h3>Ghost Risk Meter</h3>
          <p>A real ghosting-risk score for the other person specifically — built from their unanswered-message rate, a fading share of the conversation, and their longest silence. See it coming, not just the aftermath.</p>
        </div>

        <div class="analyze-card">
          <span class="tag tag-neutral">Situationship</span>
          <h3>Vibe Check</h3>
          <p>An instant read on what this actually is — romantic, situationship, friendship, business — before you sink an hour into overanalyzing one text. Classified straight from the pattern of the conversation itself.</p>
        </div>

        <div class="analyze-card">
          <span class="tag tag-neutral">Ask Anything</span>
          <h3>Ask Anything</h3>
          <p>Got a question the cards don't answer? Ask it directly — "does this person actually like me?", "am I being too much?" — and get a real answer grounded in your chat history, screenshot attachments included.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="choose-band">
    <div class="choose-wrap">
      <div class="choose-grid">
        <div class="choose-copy">
          <span class="kicker">Why Chakam</span>
          <h2>Why people keep coming back to Chakam</h2>
          <p>Most chat-analysis apps hand you one report and disappear. Chakam is built differently — every relationship you track keeps updating, not just the day you first imported it.</p>
          <p>It works across the platforms you actually use, and the insight isn't locked to one conversation: your own texting patterns, effort, and communication style get reflected back to you over time, with relationship tips you can carry into every connection — not just the one chat you happened to analyze.</p>
        </div>

        <div class="choose-checks">
          <div class="check-item"><span class="tick">✓</span> Works across 8+ messaging platforms</div>
          <div class="check-item"><span class="tick">✓</span> Reports that update, not a one-time snapshot</div>
          <div class="check-item"><span class="tick">✓</span> New insight added automatically over time</div>
          <div class="check-item"><span class="tick">✓</span> Reflects your own texting personality back to you</div>
          <div class="check-item"><span class="tick">✓</span> Relationship tips for life, not just this chat</div>
          <div class="check-item"><span class="tick">✓</span> Track vibe, interest &amp; red flags as they evolve</div>
          <div class="check-item"><span class="tick">✓</span> 100% on-device by default</div>
          <div class="check-item"><span class="tick">✓</span> Free to start, no account required</div>
        </div>
      </div>
    </div>
  </section>

  <section class="insight-band">
    <div class="why-wrap">
      <div class="section-head">
        <span class="kicker">Built for how people connect now</span>
        <h2>The emotional intelligence modern dating actually requires</h2>
        <p>Reading the room, understanding yourself, knowing when to reach out — skills every relationship in a text-first world depends on.</p>
      </div>

      <div class="insight-grid">
        <div class="analyze-card">
          <h3>Know the moment tone shifts</h3>
          <p>Most people only notice a tone shift once it's already a pattern. Chakam's Vibe Over Time tracks warmth against friction across every message, so a real shift shows up as a line moving — not a feeling you talk yourself out of.</p>
        </div>

        <div class="analyze-card">
          <h3>Better timing, not scripted lines</h3>
          <p>Chakam won't write your next text for you. But knowing whether interest is rising, cooling off, or someone's about to go quiet changes when and how you reach out — real timing instinct, built on your actual chat history instead of a guess.</p>
        </div>

        <div class="analyze-card">
          <h3>See your own patterns, not just theirs</h3>
          <p>Beyond any single chat, Chakam builds a picture of your own texting personality across every relationship you track — the same patterns worth understanding about yourself as anyone else's.</p>
        </div>

        <div class="analyze-card">
          <h3>Insight that keeps arriving</h3>
          <p>New things Chakam notices about you keep showing up on your home screen over time — the same "here's what we found so far" moments that make checking back in worth it, not a report you read once and forget.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="how">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">How it works</span>
        <h2>Three steps, one minute</h2>
        <p>No sign-up, no waiting on a server — the whole thing happens on your phone.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="num">1</div>
          <h3>Import a chat</h3>
          <p>Export straight from WhatsApp or Telegram, or drop in a few screenshots from Instagram, Snapchat, Messenger, or iMessage.</p>
        </div>
        <div class="step">
          <div class="num">2</div>
          <h3>Chakam reads it</h3>
          <p>Message counts, reply speed, double-texts, ghosting, red flags — calculated right there on your device.</p>
        </div>
        <div class="step">
          <div class="num">3</div>
          <h3>Get your wrapped</h3>
          <p>A full card deck plus a written verdict on the dynamic — save it, revisit it, or share the parts you want to.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">Supported chats</span>
        <h2>Bring the chat you've already got</h2>
        <p>Export-based sources are read directly; the rest work from screenshots.</p>
      </div>
      <div class="sources-row">
        <span class="source-pill"><img src="/assets/img/sources/whatsapp.png" alt="">WhatsApp</span>
        <span class="source-pill"><img src="/assets/img/sources/telegram.png" alt="">Telegram</span>
        <span class="source-pill"><img src="/assets/img/sources/instagram.jpg" alt="">Instagram</span>
        <span class="source-pill"><img src="/assets/img/sources/snapchat.png" alt="">Snapchat</span>
        <span class="source-pill"><img src="/assets/img/sources/messenger.jpg" alt="">Messenger</span>
        <span class="source-pill"><img src="/assets/img/sources/imessage.jpg" alt="">iMessage</span>
        <span class="source-pill"><span class="source-glyph" style="background:#FE3C72;">T</span>Tinder</span>
        <span class="source-pill"><span class="source-glyph" style="background:#FFC629; color:#17171C;">B</span>Bumble</span>
        <span class="source-pill"><span class="source-glyph" style="background:#17171C;">H</span>Hinge</span>
        <span class="source-pill source-pill-more">More</span>
      </div>
    </div>
  </section>

  <section class="privacy-band">
    <div class="why-wrap">
      <div class="why-grid">
        <div class="why-copy">
          <span class="kicker">Privacy first</span>
          <h2>Your chats were never ours to keep.</h2>
          <p>Chakam reads your chat to build your report, not to hold onto it. Every metric on the free tier never leaves your phone — and what does get sent for the AI verdict is stripped of names and identifying details before it goes anywhere.</p>

          <div class="privacy-list">
            <div class="privacy-item">
              <span class="tick">✓</span>
              <div>
                <h3>Most of your analysis never leaves your phone</h3>
                <p>Message counts, reply speed, red flags, ghost risk — every metric on the result screen is computed locally, in the app. There's nothing to intercept, because there's nothing in transit.</p>
              </div>
            </div>
            <div class="privacy-item">
              <span class="tick">✓</span>
              <div>
                <h3>What is sent gets your name stripped out first</h3>
                <p>The AI verdict works from a small, de-identified sample — real names swapped for placeholders, phone numbers and links redacted, before anything reaches a server. Names are only swapped back on your device, after the answer comes home.</p>
              </div>
            </div>
            <div class="privacy-item">
              <span class="tick">✓</span>
              <div>
                <h3>Nothing is kept once your report is built</h3>
                <p>Our backend processes each request in memory and forgets it immediately — no database of your chats, no screenshots kept around, nothing sitting on a server waiting to be leaked.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="privacy-visual">
          <div class="privacy-ring privacy-ring--outer">
            <div class="privacy-ring privacy-ring--inner">
              <img class="privacy-logo" src="/assets/img/logo.png" alt="Chakam">
              <div class="privacy-lock-badge">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="11" width="16" height="10" rx="2.5"></rect>
                  <path d="M7.5 11V7.5a4.5 4.5 0 0 1 9 0V11"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">FAQ</span>
        <h2>Good questions</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p set:html={f.a} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="download">
    <div class="wrap">
      <div class="final-cta">
        <h2>More than a wrapped.</h2>
        <p>Real dating advice grounded in your own texts, self-help tips built from your actual patterns, and the closure of finally having a straight answer — not a one-time recap, but insight that keeps showing up when you need it. Free to start, on iOS and Android.</p>
        <div class="store-row">
          <a class="store-badge" href={appStoreUrl}>
            <img src="/assets/img/apple_icon.png" alt="App Store">
            <span class="store-text">
              <span class="store-eyebrow">Download on the</span>
              <span class="store-name">App Store</span>
            </span>
          </a>
          <a class="store-badge" href={playStoreUrl}>
            <img src="/assets/img/png-clipart-goggle-playstore-icon-google-play-computer-icons-android-play-button-angle-rectangle.png" alt="Google Play">
            <span class="store-text">
              <span class="store-eyebrow">Get it on</span>
              <span class="store-name">Google Play</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
