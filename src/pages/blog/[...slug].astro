---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// H2s only for the "On this page" nav — a heading-dense long-form post
// (this template is built for those) has plenty of H3s too, and listing
// every one would turn the sidebar into a second article.
const toc = headings.filter((h) => h.depth === 2);

// Related reading: score every other post by shared tags, tie-break by
// newest. With only a handful of posts today this mostly just surfaces
// "the other posts," but the scoring means it keeps making sense as more
// get added — no manual curation to maintain per post.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    score: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
  }))
  .sort((a, b) => b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .slice(0, 3)
  .map((r) => r.post);

const appStoreUrl = 'https://apps.apple.com/ng/app/chakam-chat-wrapped-red-flag/id6792742396';
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.chakam.chatanalyzer';

const dateFmt = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

// JSON-LD Article schema — helps Google understand this is a real article
// (author, publish date) rather than just a page of text, which is worth
// more for a content-marketing play than it costs to add.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { '@type': 'Organization', name: 'Chakam' },
  publisher: { '@type': 'Organization', name: 'Chakam' },
};
---
<BaseLayout title={`${post.data.seoTitle ?? post.data.title} — Chakam`} description={post.data.description} active="blog">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <div class="wrap">
    <a class="back-link" href="/blog/">&larr; All posts</a>

    <div class="post-header">
      <span class="post-date">{dateFmt.format(post.data.date)}</span>
      <h1>{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((tag) => <a href={`/blog/`}>#{tag}</a>)}
        </div>
      )}
    </div>

    {post.data.heroImage && (
      <figure class="blog-fig blog-fig-hero">
        <img
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? post.data.title}
          loading="eager"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
        />
        <div class="blog-fig-placeholder">
          <span>Image needed:</span>
          <code>{post.data.heroImage.split('/').pop()}</code>
        </div>
      </figure>
    )}

    <div class="post-layout">
      <article class="prose">
        <Content />
      </article>

      <aside class="post-sidebar">
        <div class="sidebar-card sidebar-cta">
          <h3>Get Chakam</h3>
          <p>Free to start, on-device by default — see what your own chats actually show.</p>
          <div class="store-row">
            <a class="store-badge" href={appStoreUrl}>
              <img src="/assets/img/apple_icon.png" alt="App Store">
              <span class="store-text">
                <span class="store-eyebrow">Download on the</span>
                <span class="store-name">App Store</span>
              </span>
            </a>
            <a class="store-badge" href={playStoreUrl}>
              <img src="/assets/img/png-clipart-goggle-playstore-icon-google-play-computer-icons-android-play-button-angle-rectangle.png" alt="Google Play">
              <span class="store-text">
                <span class="store-eyebrow">Get it on</span>
                <span class="store-name">Google Play</span>
              </span>
            </a>
          </div>
        </div>

        {toc.length > 0 && (
          <div class="sidebar-card">
            <h3>On this page</h3>
            <ul class="toc-list">
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ul>
          </div>
        )}

        {related.length > 0 && (
          <div class="sidebar-card">
            <h3>Related reading</h3>
            <ul class="related-list">
              {related.map((r) => (
                <li>
                  <a href={`/blog/${r.id}/`}>{r.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    <div class="post-cta">
      <h2>Curious what your own chats say?</h2>
      <p>Chakam reads a chat you already have and turns it into the same kind of breakdown — on-device, free to start.</p>
      <a class="btn primary" href="/#download">Get Chakam</a>
    </div>
  </div>
</BaseLayout>
