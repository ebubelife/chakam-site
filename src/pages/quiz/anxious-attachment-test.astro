    }

    /* ---- the explainer below ---- */
                        @media (max-width: 640px) {
      .quiz-card, .result-band { padding: 24px 20px; border-radius: 20px; }
      .quiz-question { font-size: 21px; }
      .quiz-option { font-size: 15.5px; padding: 15px 16px; }
      .result-band h2 { font-size: 26px; }
      .result-reads, .result-app { padding: 22px 20px; }
      .result-actions .btn { flex: 1 1 100%; }
    }
  </style>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" is:inline></script>
  <script define:vars={{ QUESTIONS, BANDS, MAX_SCORE }}>
    const answers = new Array(QUESTIONS.length).fill(null);
    let current = 0;

    const el = (id) => document.getElementById(id);
    const optionsBox = el('options');

    function bandFor(score) {
      // BANDS is ordered low to high; the last one whose floor we clear wins.
      return BANDS.reduce((acc, b) => (score >= b.min ? b : acc), BANDS[0]);
    }

    function render() {
      const q = QUESTIONS[current];
      el('questionText').textContent = q.text;
      el('qNum').textContent = String(current + 1);
      el('progressFill').style.width = `${(current / QUESTIONS.length) * 100}%`;
      el('backBtn').hidden = current === 0;
      optionsBox.innerHTML = '';
      q.options.forEach((opt, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'quiz-option';
        if (answers[current] === i) b.classList.add('is-chosen');
        b.textContent = opt.text;
        b.addEventListener('click', () => choose(i));
        optionsBox.appendChild(b);
      });
    }

    function choose(i) {
      answers[current] = i;
      if (current < QUESTIONS.length - 1) {
        current += 1;
        render();
      } else {
        finish();
      }
    }

    function finish() {
      const score = answers.reduce(
        (sum, choice, qi) => sum + (choice === null ? 0 : QUESTIONS[qi].options[choice].score),
        0
      );
      const band = bandFor(score);
      const pct = Math.round((score / MAX_SCORE) * 100);

      el('bandLabel').textContent = band.label;
      el('bandSummary').textContent = band.summary;
      el('scoreNum').textContent = String(score);
      el('meterFill').style.width = `${pct}%`;

      el('bandDetail').innerHTML = '';
      band.detail.forEach((p) => {
        const para = document.createElement('p');
        para.textContent = p;
        el('bandDetail').appendChild(para);
      });

      const reads = el('bandReads');
      reads.innerHTML = '';
      band.reads.forEach((r) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = r.href;
        a.textContent = r.label;
        li.appendChild(a);
        reads.appendChild(li);
      });

      el('shareBand').textContent = band.label;
      el('shareLine').textContent = band.cardLine;
      el('shareScore').textContent = `${score} / ${MAX_SCORE}`;
      el('shareMeter').style.width = `${pct}%`;

      el('quizCard').hidden = true;
      el('result').hidden = false;
      el('result').scrollIntoView({ behavior: 'smooth', block: 'start' });

      if (window.gtag) {
        window.gtag('event', 'quiz_completed', {
          quiz_id: 'anxious_attachment_test',
          result_band: band.id,
          score,
        });
      }
    }

    el('backBtn').addEventListener('click', () => {
      if (current > 0) {
        current -= 1;
        render();
      }
    });

    el('retakeBtn').addEventListener('click', () => {
      answers.fill(null);
      current = 0;
      el('result').hidden = true;
      el('quizCard').hidden = false;
      render();
      el('quizCard').scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // Capturing before Inter has loaded reproduces the DOM/canvas font
    // mismatch that used to glue words together in exported cards.
    async function cardFontsReady() {
      try {
        await Promise.all(
          ['400', '500', '600', '700', '800', '900'].map((w) =>
            document.fonts.load(`${w} 15px "Inter"`)
          )
        );
        await document.fonts.ready;
      } catch (_) {
        /* A fallback-font export beats no export. */
      }
    }

    el('downloadBtn').addEventListener('click', async () => {
      const btn = el('downloadBtn');
      const card = el('shareCard');
      btn.disabled = true;
      const label = btn.textContent;
      btn.textContent = 'Building image…';
      try {
        await cardFontsReady();
        const canvas = await html2canvas(card, {
          backgroundColor: null,
          scale: 1,
          width: 1080,
          height: 1350,
          useCORS: true,
          logging: false,
        });
        const link = document.createElement('a');
        link.download = 'chakam-anxious-attachment-result.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
        if (window.gtag) {
          window.gtag('event', 'quiz_shared', { quiz_id: 'anxious_attachment_test' });
        }
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });

    render();
    if (window.gtag) {
      window.gtag('event', 'quiz_started', { quiz_id: 'anxious_attachment_test' });
    }
  </script>
</BaseLayout>
