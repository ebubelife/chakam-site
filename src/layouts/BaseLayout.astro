---
// Imported (not a plain <link>) so Astro's build fingerprints the output
// filename per deploy (e.g. global.a1b2c3.css) — a browser that cached an
// old CSS file under the old URL is forced to fetch the new one, since the
// URL itself changes. A plain `<link href="/assets/css/style.css">` (the
// previous setup) never changes URL between deploys, so once a browser
// cached it, CSS updates silently stopped applying for that visitor until
// they manually hard-refreshed — which is exactly what broke the hero.
import '../styles/global.css';
import { platforms } from '../data/platforms';

interface Props {
  title: string;
  description: string;
  active?: 'home' | 'about' | 'privacy' | 'terms' | 'child-safety' | 'blog' | 'help' | 'pricing';
  legal?: boolean; // wraps <main> content in .legal for the article-style pages
  ogImage?: string; // absolute or root-relative; defaults to the logo
  noindex?: boolean; // rare — not used today, kept for a future draft/preview page
}

const {
  title,
  description,
  active,
  legal = false,
  ogImage = '/assets/img/logo.png',
  noindex = false,
} = Astro.props;

// Astro.site comes from astro.config.mjs's `site` — set once there, every
// page gets a correct absolute canonical/OG URL without repeating the
// domain per page.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalURL}>
{noindex && <meta name="robots" content="noindex">}
<link rel="icon" href="/assets/img/logo.png">
<link rel="alternate" type="application/rss+xml" title="Chakam Blog" href="/blog/rss.xml">
<meta name="google-site-verification" content="mYK_l_I3vnv22zfpn22WD3LRQ-Wom1XEaOsUpGjTj24" />

<!-- Open Graph / Twitter — every page gets a shareable card, not just the
     home page, since a blog post is exactly what gets shared. -->
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={ogImageURL}>
<meta property="og:site_name" content="Chakam">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageURL}>

<!-- App-store presence signals — every page, since any page might be the
     one someone lands on first. Deliberately NOT switching twitter:card to
     "app" (the two are mutually exclusive): that would replace the rich
     image preview above on every shared link with a bare install card,
     which is a worse trade for a blog post or platform page than for the
     homepage. App Links (al:*) coexist fine with a normal OG card instead
     of replacing it, so that's the mechanism used here. -->
<meta name="apple-itunes-app" content="app-id=6792742396">
<meta property="al:ios:app_store_id" content="6792742396">
<meta property="al:ios:app_name" content="Chakam">
<meta property="al:android:package" content="com.chakam.chatanalyzer">
<meta property="al:android:app_name" content="Chakam">
<meta property="al:web:url" content={canonicalURL}>

<!-- GA4, via the "Chakam Website" stream in the same Firebase project
     (chakam-bfb39) the app reports to — one property, app + web both in
     it. Plain gtag.js, not the firebase npm package: same data, no SDK
     bundle needed for a static site. Production builds only, AND a
     runtime hostname check — `astro build` bakes PROD=true into every
     local `preview` run too (there's no separate staging mode), and a
     local screenshot-QA pass (see this repo's history) would otherwise
     fire real hits under a "localhost" hostname. The hostname check is
     the one that actually matters; PROD skips even loading the script
     during `astro dev`. -->
{import.meta.env.PROD && (
  <>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BM6FPQM9VK"></script>
    <script define:vars={{ id: 'G-BM6FPQM9VK' }}>
      if (/(^|\.)chakam\.site$/.test(location.hostname)) {
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', id);
      }
    </script>
  </>
)}

<slot name="head" />
</head>
<body>

<header class="site">
  <div class="wrap">
    <a class="brand" href="/">
      <img src="/assets/img/logo.png" alt="Chakam">
      Chakam
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <svg class="nav-toggle-icon" viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path class="nav-toggle-top" d="M3 6h14"></path>
        <path class="nav-toggle-mid" d="M3 10h14"></path>
        <path class="nav-toggle-bottom" d="M3 14h14"></path>
      </svg>
    </button>
    <nav class="site-nav" id="site-nav">
      <a href="/" class={active === 'home' ? 'active' : ''}>Home</a>
      <a href="/blog/" class={active === 'blog' ? 'active' : ''}>Blog</a>
      <a href="/about/" class={active === 'about' ? 'active' : ''}>About</a>

      <div class="nav-drop">
        <button class="nav-drop-btn" type="button" aria-expanded="false" aria-haspopup="true">
          Platform
          <svg class="nav-drop-chevron" viewBox="0 0 12 8" width="10" height="7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1.5 6 6.5 11 1.5"></path></svg>
        </button>
        <div class="nav-drop-menu">
          {platforms.map((p) => (
            <a href={`/${p.slug}/`}>{p.navLabel}</a>
          ))}
        </div>
      </div>

      <div class="nav-drop">
        <button class="nav-drop-btn" type="button" aria-expanded="false" aria-haspopup="true">
          Features
          <svg class="nav-drop-chevron" viewBox="0 0 12 8" width="10" height="7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1.5 6 6.5 11 1.5"></path></svg>
        </button>
        <div class="nav-drop-menu">
          <a href="/#why">AI Chat Analysis &amp; Verdict</a>
          <a href="/#analyze">Red Flags, Green Flags &amp; Ghost Risk</a>
          <a href="/#insight">Relationship &amp; Dating Insights</a>
        </div>
      </div>

      <div class="nav-drop">
        <button class="nav-drop-btn" type="button" aria-expanded="false" aria-haspopup="true">
          Resources
          <svg class="nav-drop-chevron" viewBox="0 0 12 8" width="10" height="7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1.5 6 6.5 11 1.5"></path></svg>
        </button>
        <div class="nav-drop-menu">
          <a href="/blog/">Blog</a>
          <a href="/pricing/">Pricing</a>
          <a href="/help/">Help &amp; Support</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<main>
  {legal ? <div class="wrap legal"><slot /></div> : <slot />}
</main>

<footer class="site">
  <div class="wrap">
    <p>&copy; 2026 Chakam · a Kodeblooded product</p>
    <div class="links">
      <a href="/blog/">Blog</a>
      <a href="/pricing/">Pricing</a>
      <a href="/help/">Help &amp; Support</a>
      <a href="/about/">About</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/child-safety/">Child Safety</a>
      <a href="mailto:info@kodeblooded.com.ng">Contact</a>
    </div>
  </div>
</footer>

<script>
  const navToggle = document.querySelector('.nav-toggle');
  const siteNav = document.querySelector('.site-nav');

  function closeDrops() {
    document.querySelectorAll('.nav-drop.open').forEach((d) => {
      d.classList.remove('open');
      d.querySelector('.nav-drop-btn')?.setAttribute('aria-expanded', 'false');
    });
  }

  // The mobile hamburger panel and the Platform/Features/Resources
  // dropdowns inside it are two independent open/close states — closing
  // the outer panel also resets any dropdown left open inside it, so it
  // doesn't reappear pre-expanded next time it's opened.
  function closeMobileNav() {
    siteNav?.classList.remove('open');
    navToggle?.setAttribute('aria-expanded', 'false');
    closeDrops();
  }

  navToggle?.addEventListener('click', () => {
    const isOpen = siteNav?.classList.contains('open');
    if (isOpen) {
      closeMobileNav();
    } else {
      siteNav?.classList.add('open');
      navToggle.setAttribute('aria-expanded', 'true');
    }
  });

  // Click-to-toggle nav dropdowns (Platform/Features/Resources) — not
  // hover-based, since hover doesn't exist on touch devices and this way
  // desktop and mobile share the exact same interaction.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.nav-drop-btn');
    if (btn) {
      const drop = btn.closest('.nav-drop');
      if (!drop) return;
      const isOpen = drop.classList.contains('open');
      closeDrops();
      if (!isOpen) {
        drop.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
      return;
    }
    // A plain nav link (Home/Blog/About, or one inside an open dropdown)
    // navigates the page away regardless, but closing first avoids a
    // flash of the open panel on browsers that serve the next page from
    // cache with the old DOM state (back/forward cache).
    if (target.closest('.site-nav') && target.tagName === 'A') {
      closeMobileNav();
      return;
    }
    if (!target.closest('.nav-drop')) {
      closeDrops();
    }
    if (!target.closest('.site-nav') && !target.closest('.nav-toggle')) {
      closeMobileNav();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMobileNav();
    }
  });
</script>

</body>
</html>
