---
// Deliberately its own layout, not BaseLayout — the public marketing nav
// (Platform/Features/Resources dropdowns) is irrelevant clutter on an
// internal content-creation tool, and BaseLayout has no way to hide it.
// Reuses global.css for the base reset/fonts/color tokens only.
import '../styles/global.css';
import { tools } from '../data/tools';

interface Props {
  title: string;
  activeSlug?: string;
}

const { title, activeSlug } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title} · Chakam Tools</title>
<!-- Internal workspace, not a public page — see astro.config.mjs's
     sitemap filter for the other half of keeping this out of search. -->
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/assets/img/logo.png">
<style>
  :root {
    --sidebar-w: 240px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .shell {
    display: flex;
    min-height: 100vh;
  }
  .sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    background: var(--ink);
    color: #fff;
    padding: 20px 16px;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }
  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 4px 18px;
    margin-bottom: 12px;
    border-bottom: 1px solid rgba(255,255,255,0.12);
    font-weight: 800;
    font-size: 15px;
  }
  .sidebar-brand img { width: 26px; height: 26px; border-radius: 7px; }
  .sidebar-kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    padding: 4px 8px 8px;
  }
  .tool-link {
    display: block;
    padding: 10px 10px;
    border-radius: 10px;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 600;
    margin-bottom: 2px;
  }
  .tool-link .desc {
    display: block;
    font-size: 11.5px;
    font-weight: 500;
    color: rgba(255,255,255,0.4);
    margin-top: 2px;
  }
  .tool-link:hover { background: rgba(255,255,255,0.06); color: #fff; }
  .tool-link.active {
    background: var(--yellow);
    color: var(--ink);
  }
  .tool-link.active .desc { color: rgba(23,23,28,0.6); }
  .sidebar-back {
    display: block;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    font-size: 12px;
  }
  .sidebar-back:hover { color: rgba(255,255,255,0.7); }
  .main {
    flex: 1;
    min-width: 0;
    padding: 28px 32px 60px;
  }
  @media (max-width: 780px) {
    .shell { flex-direction: column; }
    .sidebar {
      width: 100%;
      height: auto;
      position: static;
      display: flex;
      align-items: center;
      gap: 10px;
      overflow-x: auto;
      padding: 14px 16px;
    }
    .sidebar-brand, .sidebar-kicker, .sidebar-back { display: none; }
    .tool-link { white-space: nowrap; margin-bottom: 0; }
    .tool-link .desc { display: none; }
    .main { padding: 20px 16px 48px; }
  }
</style>
<slot name="head" />
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <a class="sidebar-brand" href="/tools/">
      <img src="/assets/img/logo.png" alt="">
      Chakam Tools
    </a>
    <div class="sidebar-kicker">Content tools</div>
    {tools.map((t) => (
      <a class={`tool-link ${activeSlug === t.slug ? 'active' : ''}`} href={`/tools/${t.slug}/`}>
        {t.label}
        <span class="desc">{t.description}</span>
      </a>
    ))}
    <a class="sidebar-back" href="/">&larr; Back to chakam.site</a>
  </aside>
  <main class="main">
    <slot />
  </main>
</div>
</body>
</html>
